# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Uncomment ONE provider block. Get a free Groq key at https://console.groq.com/
# or a free Gemini key at https://aistudio.google.com/apikey (create in new project)

# Groq (recommended — free tier, fast)
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=your-groq-key-here

# Google Gemini (alternative)
# LLM_MODEL=gemini/gemini-2.0-flash-lite
# GEMINI_API_KEY=your-gemini-key-here

# Anthropic Claude (alternative)
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Backup models tried in order if LLM_MODEL fails (deprecation/outage/rate limit).
# Defaults (in config.py) stay on Groq so one model dying never breaks the app.
# LLM_FALLBACKS=groq/openai/gpt-oss-20b,groq/qwen/qwen3-32b

# ─── Backend ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./pipeforge.db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE_MB=1000
EXECUTION_TIMEOUT_SECONDS=60
LARGE_FILE_THRESHOLD_MB=10

# ─── Auth ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-a-random-64-char-string-here
# Generate: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite build-time vars) ────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
